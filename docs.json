{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LightSwap Documentation",
  "colors": {
    "primary": "#0C8C5E",
    "light": "#18E299",
    "dark": "#18E299"
  },
  "favicon": "/favicon.svg",
  "redirects": [
    {
      "source": "/revenue-sharing",
      "destination": "/business/revenue-sharing"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Introduction",
            "icon": "book-open",
            "pages": [
              "index",
              "how-swaps-work",
              "fees-and-rates",
              "supported-networks",
              "faq",
              "glossary"
            ]
          },
          {
            "group": "Swaps",
            "icon": "repeat",
            "pages": [
              "swaps/make-a-swap",
              "swaps/track-a-swap",
              "swaps/troubleshooting"
            ]
          },
          {
            "group": "Account",
            "icon": "user",
            "pages": [
              "account/overview",
              "account/balances",
              "account/swap-from-balance",
              "account/history",
              "account/referrals",
              "account/earn",
              "account/telegram"
            ]
          },
          {
            "group": "Support",
            "icon": "life-ring",
            "pages": [
              "support"
            ]
          }
        ]
      },
      {
        "tab": "Business",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "business/overview",
              "business/quickstart",
              "business/revenue-sharing",
              "business/changelog"
            ]
          },
          {
            "group": "Direct API",
            "icon": "code",
            "pages": [
              "integrations/direct-api/introduction",
              "integrations/direct-api/authentication",
              "integrations/direct-api/integration-flow",
              "integrations/direct-api/statuses-errors",
              "integrations/direct-api/limits",
              "integrations/direct-api/refunds"
            ]
          },
          {
            "group": "Widget",
            "icon": "app-window",
            "pages": [
              "integrations/widget/introduction"
            ]
          },
          {
            "group": "API Reference",
            "icon": "square-terminal",
            "pages": [
              "api-reference/introduction",
              "api-reference/asset",
              "api-reference/address",
              "api-reference/quote",
              "api-reference/swap",
              "api-reference/swaps",
              "api-reference/swap-status"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/title-logo.png",
    "dark": "/logo/title-logo-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://lightswap.me/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://lightswap.me"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
